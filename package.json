{
  "name": "motivative",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "tsx apps/api/src/index.ts",
    "dev:desktop": "electron apps/desktop/main.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts && tsup apps/api/src/index.ts --format esm --platform node --out-dir dist/api --external better-sqlite3",
    "start": "node dist/api/index.js",
    "simulate": "tsx scripts/simulate.ts",
    "verify:collector": "tsx scripts/verify-collector.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.5",
    "prettier": "^3.9.9",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
